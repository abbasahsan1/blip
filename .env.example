# ==============================================================================
# Blipp Platform Environment Configuration
# ==============================================================================

# --- Cluster & Network ---
CLUSTER_NAME=blipp-cluster
HOST_IP=100.122.207.32
HOST_PORT=8419
NAMESPACE=blipp

# --- PostgreSQL (Keycloak Database & Service Databases) ---
# Default PostgreSQL DB (used by Keycloak only)
POSTGRES_DB=keycloak
# Per-service logical databases (set in K8s deployments)
# AUTH_POSTGRES_DB=blipp_auth
# INGEST_POSTGRES_DB=blipp_ingest
# FEED_POSTGRES_DB=blipp_feed
# SOCIAL_POSTGRES_DB=blipp_social
# ANALYTICS_POSTGRES_DB=blipp_analytics
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_secure_db_pass
POSTGRES_HOST=postgres.blipp.svc.cluster.local
POSTGRES_PORT=5432

# --- Keycloak Identity Provider ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_master_password
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin_master_password
KEYCLOAK_URL=http://100.122.207.32:8419/keycloak
KEYCLOAK_INTERNAL_URL=http://keycloak.blipp.svc.cluster.local:8080/keycloak
KEYCLOAK_REALM=blipp
KEYCLOAK_CLIENT_ID=blipp-app
KEYCLOAK_CLIENT_SECRET=blipp-secret-client-token

# --- FastAPI Authentication Service ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_ENV=production

# --- Expo Web Application (Blipp) ---
EXPO_PUBLIC_API_URL=http://100.122.207.32:8419/api
EXPO_PUBLIC_KEYCLOAK_URL=http://100.122.207.32:8419/keycloak
EXPO_PUBLIC_KEYCLOAK_REALM=blipp
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=blipp-app

# --- NATS JetStream Event Bus ---
NATS_URL=nats://nats.blipp.svc.cluster.local:4222
NATS_STREAM_UPLOADS=UPLOADS
NATS_STREAM_ENGAGEMENT=ENGAGEMENT
NATS_SUBJECT_UPLOADS=upload.>
NATS_SUBJECT_ENGAGEMENT=engagement.>

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio.blipp.svc.cluster.local:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION_NAME=us-east-1
S3_BUCKET_RAW_UPLOADS=blipp-raw-uploads
S3_BUCKET_AUDIO_VARIANTS=blipp-audio-variants
S3_BUCKET_NAME=blipp-raw-uploads
S3_USE_SSL=false
S3_PUBLIC_URL=http://100.122.207.32:8419/v1/blipps/audio

# --- Redis Cache ---
REDIS_URL=redis://redis.blipp.svc.cluster.local:6379/0

# --- Gorse Recommender Engine ---
GORSE_API_URL=http://gorse.blipp.svc.cluster.local:8088
GORSE_API_KEY=

