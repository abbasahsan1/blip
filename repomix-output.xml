apiVersion: batch/v1
kind: Job
metadata:
  name: minio-setup-buckets
  namespace: blipp
  labels:
    app.kubernetes.io/name: minio-setup
    app.kubernetes.io/component: object-storage
    app.kubernetes.io/part-of: blipp
spec:
  ttlSecondsAfterFinished: 120
  backoffLimit: 5
  template:
    metadata:
      labels:
        app.kubernetes.io/name: minio-setup
        app.kubernetes.io/component: object-storage
        app.kubernetes.io/part-of: blipp
    spec:
      restartPolicy: OnFailure
      initContainers:
        - name: wait-for-minio
          image: busybox:1.36
          command:
            - /bin/sh
            - -c
            - |
              echo "Waiting for MinIO service to respond on port 9000..."
              until nc -z minio.blipp.svc.cluster.local 9000; do
                sleep 2
              done
              echo "MinIO port is open."
      containers:
        - name: mc
          image: minio/mc:latest
          imagePullPolicy: IfNotPresent
          env:
            - name: MINIO_ROOT_USER
              valueFrom:
                secretKeyRef:
                  name: blipp-secrets
                  key: MINIO_ROOT_USER
                  optional: true
            - name: MINIO_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: blipp-secrets
                  key: MINIO_ROOT_PASSWORD
                  optional: true
          command:
            - /bin/sh
            - -c
            - |
              USER=${MINIO_ROOT_USER:-minioadmin}
              PASS=${MINIO_ROOT_PASSWORD:-minioadmin}
              echo "Configuring MinIO client alias..."
              mc alias set localminio http://minio.blipp.svc.cluster.local:9000 "$USER" "$PASS"
              echo "Creating default buckets..."
              mc mb --ignore-existing localminio/blipp-raw-uploads
              mc mb --ignore-existing localminio/blipp-audio-variants
              mc mb --ignore-existing localminio/blipp-stories
              mc mb --ignore-existing localminio/blipp-uploads
              mc mb --ignore-existing localminio/blipp-variants
              echo "Configuring public download policy on blipp-audio-variants..."
              mc anonymous set download localminio/blipp-audio-variants
              echo "Enforcing strictly private policy for raw uploads..."
              mc anonymous set none localminio/blipp-raw-uploads
              echo "Listing buckets:"
              mc ls localminio
              echo "MinIO bucket initialization complete!"
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
</file>

