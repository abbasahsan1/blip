CODE_INTERNAL_SERVER_ERROR = "INTERNAL_SERVER_ERROR"
CODE_FORBIDDEN = "FORBIDDEN"
CODE_NOT_FOUND = "NOT_FOUND"

__all__ = [
    "AppException",
    "CODE_INVALID_CREDENTIALS",
    "CODE_UNAUTHORIZED",
    "CODE_TOKEN_EXPIRED",
    "CODE_INVALID_TOKEN",
    "CODE_USER_ALREADY_EXISTS",
