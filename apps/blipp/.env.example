# ==============================================================================
# Blipp Mobile App Environment Variables
# ==============================================================================
# In Expo Go and React Native, variables prefixed with EXPO_PUBLIC_ are bundled
# into the client application.
#
# When running on physical devices via Expo Go over Wi-Fi/LAN, localhost will
# resolve to the phone itself rather than your development machine.
#
# Use `make dev-mobile` or `scripts/dev-mobile.sh` to automatically detect your
# local IP and configure .env, or set your machine's LAN IP manually below:
# ==============================================================================

# FastAPI Backend Services base URL
EXPO_PUBLIC_API_URL=http://localhost:8000/v1

# Keycloak Identity Provider base URL
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080/keycloak
