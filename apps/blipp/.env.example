# ==============================================================================
# Blipp Mobile App Environment Variables
# ==============================================================================
# In Expo Go and React Native, variables prefixed with EXPO_PUBLIC_ are bundled
# into the client application.
#
# When running on physical devices via Expo Go over Tailscale or Wi-Fi/LAN,
# localhost resolves to the mobile device itself rather than your host machine.
#
# Use `make dev-mobile` or `scripts/dev-mobile.sh` to automatically detect your
# Tailscale / LAN IP and configure .env, or set your machine's IP manually below:
# ==============================================================================

EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_CONTENT_INGEST_URL=http://localhost:8001
EXPO_PUBLIC_FEED_URL=http://localhost:8002
EXPO_PUBLIC_SOCIAL_GRAPH_URL=http://localhost:8003
EXPO_PUBLIC_MESSAGING_URL=http://localhost:8004
EXPO_PUBLIC_MODERATION_URL=http://localhost:8005
EXPO_PUBLIC_MINIO_URL=http://localhost:9000
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8080
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
